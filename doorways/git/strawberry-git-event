#!/usr/bin/env bash
# Git doorway helper (WIRING.md §5): turn one git hook firing into one POST to strawberryd.
#
#   strawberry-git-event post-commit
#   strawberry-git-event pre-push <remote> <commit-count>
#
# Detaches itself, gives up after a second, never fails. A hook must never slow or
# break git, whoever is driving it (terminal, Claude Code, Codex, an IDE).
set -u

hook="${1:-unknown}"
url="${STRAWBERRYD_URL:-http://127.0.0.1:8770}"

repo="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"

case "$hook" in
  post-commit)
    body="$(git log -1 --pretty=%s 2>/dev/null)"
    ;;
  pre-push)
    remote="${2:-origin}"
    count="${3:-?}"
    plural="commits"; [ "$count" = "1" ] && plural="commit"
    body="pushing $count $plural on $branch to $remote"
    ;;
  *)
    body="$hook"
    ;;
esac

# jq does the JSON escaping; commit subjects contain quotes more often than you'd think.
payload="$(jq -cn --arg app "$hook" --arg title "$repo" --arg body "$body" \
  '{source: "git", app: $app, title: $title, body: $body}')"

setsid -f curl -s -m 1 -o /dev/null -H 'Content-Type: application/json' \
  -d "$payload" "$url/event" >/dev/null 2>&1 </dev/null || true
exit 0
