#!/usr/bin/env bash
# Strawberry from a source checkout: run the `strawberry` CLI (src/strawberry/cli.py) from the
# checkout's own venv, creating it on first use. Every command and flag is the CLI's:
#
#   bin/strawberry --help        the commands (widget, daemon, tray, status, install, say, ...)
#   bin/strawberry               start the daemon and doorways if needed, open the widget
#
# Installed with `uv tool install`, the same CLI is simply `strawberry` on PATH.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CLI="$ROOT/.venv/bin/strawberry"
if [ ! -x "$CLI" ]; then
  # --inexact keeps whatever else the venv has; the gpu group is the CUDA wheels whisper uses.
  (cd "$ROOT" && uv sync --quiet --inexact --group gpu)
fi
exec "$CLI" "$@"
