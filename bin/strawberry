#!/usr/bin/env bash
# Strawberry launcher: make sure strawberryd is up, then open the desktop widget.
#
#   strawberry            start daemon + media watcher if needed, open the widget
#   strawberry daemon     start the daemon + watcher only (idempotent)
#   strawberry status     daemon health, watcher state
#   strawberry stop       stop the daemon and watcher
#
# STRAWBERRYD_PORT overrides the port (default 8770).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/strawberry"
PORT="${STRAWBERRYD_PORT:-8770}"
HEALTH="http://127.0.0.1:$PORT/health"
PIDFILE="$STATE_DIR/strawberryd.pid"
LOG="$STATE_DIR/strawberryd.log"
WATCH_PIDFILE="$STATE_DIR/mpris_watch.pid"
WATCH_LOG="$STATE_DIR/mpris_watch.log"
mkdir -p "$STATE_DIR"

daemon_up() { curl -fsS "$HEALTH" >/dev/null 2>&1; }
pid_alive() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }

start_watcher() {
  # Media doorway (WIRING.md §4b). System python3: it needs PyGObject, which Ubuntu ships.
  if pid_alive "$WATCH_PIDFILE"; then return; fi
  echo "starting media watcher (log: $WATCH_LOG)"
  nohup /usr/bin/python3 "$ROOT/doorways/mpris_watch.py" --daemon "http://127.0.0.1:$PORT" >>"$WATCH_LOG" 2>&1 &
  echo $! >"$WATCH_PIDFILE"
}

stop_pidfile() {
  if [ -f "$1" ] && kill "$(cat "$1")" 2>/dev/null; then echo "$2 stopped"; else echo "$2: not running"; fi
  rm -f "$1"
}

start_daemon() {
  if daemon_up; then return; fi
  (cd "$ROOT/strawberryd" && uv sync --quiet)
  echo "starting strawberryd on :$PORT (log: $LOG)"
  nohup "$ROOT/strawberryd/.venv/bin/strawberryd" --port "$PORT" >>"$LOG" 2>&1 &
  echo $! >"$PIDFILE"
  for _ in $(seq 1 50); do daemon_up && return; sleep 0.1; done
  echo "strawberryd did not come up; see $LOG" >&2
  exit 1
}

start_widget() {
  if [ ! -d "$ROOT/widget/.godot" ]; then
    echo "importing widget project (first run)"
    godot --headless --path "$ROOT/widget" --editor --import >/dev/null 2>&1 || true
  fi
  # Pinned to the X11 backend on purpose: native on an X11 session, XWayland on a
  # Wayland one. Native Wayland clients on GNOME get neither always-on-top nor
  # self-positioning, which is what makes a desktop pet a pet (WIRING.md §13).
  exec godot --display-driver x11 --path "$ROOT/widget" -- --ws="ws://127.0.0.1:$PORT/ws" "$@"
}

case "${1:-widget}" in
  widget) shift || true; start_daemon; start_watcher; start_widget "$@" ;;
  daemon) start_daemon; start_watcher; echo "strawberryd up on :$PORT" ;;
  status)
    if daemon_up; then curl -fsS "$HEALTH"; echo; else echo "strawberryd: down"; fi
    if pid_alive "$WATCH_PIDFILE"; then echo "mpris watcher: up"; else echo "mpris watcher: down"; fi
    daemon_up ;;
  stop)
    stop_pidfile "$WATCH_PIDFILE" "mpris watcher"
    stop_pidfile "$PIDFILE" "strawberryd" ;;
  *) sed -n '2,10p' "$0"; exit 2 ;;
esac
