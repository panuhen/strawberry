#!/usr/bin/env bash
# Strawberry launcher: make sure strawberryd is up, then open the desktop widget.
#
#   strawberry            start daemon + doorway watchers if needed, open the widget
#   strawberry daemon     start the daemon + watchers only (idempotent)
#   strawberry status     daemon health, watcher states
#   strawberry stop       stop the daemon and watchers
#   strawberry restart    stop + daemon (after editing the config)
#   strawberry config     create ~/.config/strawberry/config.toml if missing, then open it in $EDITOR
#   strawberry say TEXT   make her say TEXT now (through the running daemon and widget)
#   strawberry voices [NAME...]   list installed Piper voices, or download the named ones
#   strawberry audition [TEXT]    play a sample line in every installed voice
#   strawberry install    start on login: systemd user units for daemon + watchers, autostart for the widget
#   strawberry uninstall  undo install (she only runs when you launch her)
#
# After `install`, daemon/stop/restart/status drive the systemd units instead of pidfiles.
# Settings live in ~/.config/strawberry/config.toml (WIRING.md §15); STRAWBERRYD_PORT still overrides.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/strawberry"
D="$ROOT/strawberryd/.venv/bin/strawberryd"
[ -x "$D" ] || (cd "$ROOT/strawberryd" && uv sync --quiet)
PORT="${STRAWBERRYD_PORT:-$("$D" --print-port 2>/dev/null || echo 8770)}"
HEALTH="http://127.0.0.1:$PORT/health"
PIDFILE="$STATE_DIR/strawberryd.pid"
LOG="$STATE_DIR/strawberryd.log"
VOICES_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/strawberry/voices"
mkdir -p "$STATE_DIR"

daemon_up() { curl -fsS "$HEALTH" >/dev/null 2>&1; }
pid_alive() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }
wait_daemon() {
  for _ in $(seq 1 80); do daemon_up && return 0; sleep 0.1; done
  echo "strawberryd did not come up; see $LOG (or: journalctl --user -u strawberryd)" >&2
  return 1
}

# Doorways run as background watchers on the system python3 (they need PyGObject, which Ubuntu ships).
DOORWAYS=(mpris_watch notify_watch beat_watch)

# --- start on login (systemd --user + XDG autostart) --------------------------------
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/strawberry.desktop"
UNITS=(strawberryd.service); for w in "${DOORWAYS[@]}"; do UNITS+=("strawberry-$w.service"); done
WATCHER_UNITS="${UNITS[*]:1}"
managed() { systemctl --user is-enabled strawberryd.service >/dev/null 2>&1; }

write_units() {
  mkdir -p "$UNIT_DIR" "$(dirname "$AUTOSTART")"
  cat >"$UNIT_DIR/strawberryd.service" <<EOF
[Unit]
Description=Strawberry mascot daemon (event intake, brain, voice, websocket to the widget)
After=graphical-session.target
Wants=$WATCHER_UNITS

[Service]
ExecStart=$D --port $PORT
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
EOF
  for w in "${DOORWAYS[@]}"; do
    cat >"$UNIT_DIR/strawberry-$w.service" <<EOF
[Unit]
Description=Strawberry doorway: $w
After=strawberryd.service
PartOf=strawberryd.service

[Service]
ExecStart=/usr/bin/python3 $ROOT/doorways/$w.py --daemon http://127.0.0.1:$PORT
Restart=on-failure
RestartSec=3

[Install]
WantedBy=strawberryd.service
EOF
  done
  cat >"$AUTOSTART" <<EOF
[Desktop Entry]
Type=Application
Name=Strawberry
Comment=Desktop crab
Exec=$ROOT/bin/strawberry widget
X-GNOME-Autostart-Delay=3
StartupNotify=false
EOF
}

install_login() {
  # Hand over from pidfile-managed processes, if any, so the port is free for the unit.
  stop_watchers_pidfile >/dev/null; stop_pidfile "$PIDFILE" "strawberryd" >/dev/null
  (cd "$ROOT/strawberryd" && uv sync --quiet)
  write_units
  systemctl --user daemon-reload
  systemctl --user enable --now "${UNITS[@]}"
  wait_daemon && echo "installed: strawberryd + watchers run under systemd --user; the widget autostarts at login ($AUTOSTART)"
  echo "logs: journalctl --user -u strawberryd -f"
}

uninstall_login() {
  systemctl --user disable --now "${UNITS[@]}" 2>/dev/null || true
  for u in "${UNITS[@]}"; do rm -f "$UNIT_DIR/$u"; done
  systemctl --user daemon-reload
  rm -f "$AUTOSTART"
  echo "uninstalled: she now runs only when you start her with bin/strawberry"
}

# --- pidfile-managed processes (when not installed) ---------------------------------
start_watcher() {  # $1 = doorway script name without .py
  local pidfile="$STATE_DIR/$1.pid" logfile="$STATE_DIR/$1.log"
  if pid_alive "$pidfile"; then return; fi
  echo "starting $1 (log: $logfile)"
  nohup /usr/bin/python3 "$ROOT/doorways/$1.py" --daemon "http://127.0.0.1:$PORT" >>"$logfile" 2>&1 &
  echo $! >"$pidfile"
}
stop_watchers_pidfile() { for w in "${DOORWAYS[@]}"; do stop_pidfile "$STATE_DIR/$w.pid" "$w"; done; }

stop_pidfile() {
  if [ -f "$1" ] && kill "$(cat "$1")" 2>/dev/null; then echo "$2 stopped"; else echo "$2: not running"; fi
  rm -f "$1"
}

start_watchers() {
  if managed; then return; fi   # the daemon unit Wants the watcher units
  for w in "${DOORWAYS[@]}"; do start_watcher "$w"; done
}
stop_watchers() {
  if managed; then return; fi   # PartOf= stops them with the daemon unit
  stop_watchers_pidfile
}
status_watchers() {
  for w in "${DOORWAYS[@]}"; do
    if managed; then echo "$w: $(systemctl --user is-active "strawberry-$w.service")"
    elif pid_alive "$STATE_DIR/$w.pid"; then echo "$w: up"; else echo "$w: down"; fi
  done
}

start_daemon() {
  if daemon_up; then return; fi
  if managed; then
    systemctl --user start strawberryd.service
    wait_daemon || exit 1
    return
  fi
  (cd "$ROOT/strawberryd" && uv sync --quiet)
  echo "starting strawberryd on :$PORT (log: $LOG)"
  nohup "$D" --port "$PORT" >>"$LOG" 2>&1 &
  echo $! >"$PIDFILE"
  wait_daemon || exit 1
}

stop_daemon() {
  if managed; then systemctl --user stop strawberryd.service && echo "strawberryd stopped (systemd)"; return; fi
  stop_pidfile "$PIDFILE" "strawberryd"
}

start_widget() {
  if [ ! -d "$ROOT/widget/.godot" ]; then
    echo "importing widget project (first run)"
    godot --headless --path "$ROOT/widget" --editor --import >/dev/null 2>&1 || true
  fi
  # Pinned to the X11 backend on purpose: native on an X11 session, XWayland on a
  # Wayland one. Native Wayland clients on GNOME get neither always-on-top nor
  # self-positioning, which is what makes a desktop pet a pet (WIRING.md §13).
  exec godot --display-driver x11 --path "$ROOT/widget" -- --ws="ws://127.0.0.1:$PORT/ws" "$@"
}

case "${1:-widget}" in
  widget) shift || true; start_daemon; start_watchers; start_widget "$@" ;;
  daemon) start_daemon; start_watchers; echo "strawberryd up on :$PORT" ;;
  status)
    if managed; then echo "managed by systemd --user (strawberry uninstall to stop that)"; fi
    if daemon_up; then curl -fsS "$HEALTH"; echo; else echo "strawberryd: down"; fi
    status_watchers
    daemon_up ;;
  stop)
    stop_watchers
    stop_daemon ;;
  restart)
    if managed; then systemctl --user restart strawberryd.service; wait_daemon && echo "strawberryd restarted (systemd)"
    else "$0" stop; sleep 0.5; "$0" daemon; fi ;;
  install) install_login ;;
  uninstall) uninstall_login ;;
  config)
    CFG="${XDG_CONFIG_HOME:-$HOME/.config}/strawberry/config.toml"
    [ -f "$CFG" ] || "$D" --init-config
    if [ -n "${EDITOR:-}" ]; then "$EDITOR" "$CFG"; else echo "$CFG"; echo "(set \$EDITOR to open it automatically; restart with: strawberry restart)"; fi ;;
  say)
    shift; [ $# -gt 0 ] || { echo "usage: strawberry say TEXT" >&2; exit 2; }
    daemon_up || { echo "strawberryd is down; start it with: strawberry daemon" >&2; exit 1; }
    jq -cn --arg t "$*" '{state:"talking", text:$t, emotion:"happy"}' \
      | curl -fsS -H 'Content-Type: application/json' -d @- "http://127.0.0.1:$PORT/perform" >/dev/null && echo "said: $*" ;;
  voices)
    shift
    if [ $# -eq 0 ]; then
      ls "$VOICES_DIR"/*.onnx 2>/dev/null | xargs -rn1 basename | sed 's/\.onnx$//' || true
      echo "(download more with: strawberry voices en_US-amy-medium; catalogue: https://rhasspy.github.io/piper-samples/)"
    else
      mkdir -p "$VOICES_DIR"
      (cd "$ROOT/strawberryd" && uv run --quiet python -m piper.download_voices --download-dir "$VOICES_DIR" "$@")
    fi ;;
  audition)
    shift; LINE="${*:-James, hold the phone, the time is up! Your commit landed, nice work.}"
    for v in $("$0" voices | grep -v '^('); do
      WAV="$("$D" --say "$LINE" --voice "$v" 2>/dev/null)" || { echo "$v: failed" >&2; continue; }
      echo "$v"; paplay "$WAV" 2>/dev/null || aplay -q "$WAV"
    done ;;
  *) sed -n '2,17p' "$0"; exit 2 ;;
esac
