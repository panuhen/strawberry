#!/usr/bin/env bash
# Strawberry launcher: make sure strawberryd is up, then open the desktop widget.
#
#   strawberry            start daemon + doorway watchers if needed, open the widget
#   strawberry daemon     start the daemon + watchers only (idempotent)
#   strawberry status     daemon health, watcher states
#   strawberry stop       stop the daemon and watchers
#   strawberry restart    stop + daemon (after editing the config)
#   strawberry config     create ~/.config/strawberry/config.toml if missing, then open it in $EDITOR
#   strawberry say TEXT   make her say TEXT now (through the running daemon and widget)
#   strawberry voices [NAME...]   list installed Piper voices, or download the named ones
#   strawberry audition [TEXT]    play a sample line in every installed voice
#   strawberry listen     talk to her once (what the hotkey runs); press again to stop early
#   strawberry route TEXT what the gate makes of a sentence (kind, topic, confidence, decision); for tuning
#   strawberry tools [TOPIC]         list the MCP tools she can reach
#   strawberry tool SERVER NAME [JSON]  call one MCP tool by hand, e.g. strawberry tool spotify next
#   strawberry think TEXT            run TEXT through the thinker (Qwen + the tools) by hand
#   strawberry talk                  type to her: each line goes through the daemon as if spoken, routing shown
#   strawberry hotkey [COMBO|--remove]  GNOME shortcut for `listen` (default <Super><Shift>space)
#   strawberry tray       the tray icon, and under it the daemon, the doorways and the widget
#   strawberry install    start on login: one systemd user unit for the tray, autostart as a fallback
#   strawberry uninstall  undo install (she only runs when you launch her)
#
# After `install`, daemon/stop/restart/status drive the tray unit instead of pidfiles.
# Settings live in ~/.config/strawberry/config.toml (WIRING.md §15); STRAWBERRYD_PORT still overrides.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/strawberry"
D="$ROOT/.venv/bin/strawberryd"
PY="$ROOT/.venv/bin/python"
[ -x "$D" ] || (cd "$ROOT" && uv sync --quiet --inexact --group gpu)
# The port straight from the TOML (awk, ~1 ms) rather than `strawberryd --print-port` (~300 ms of
# Python start-up): the hotkey runs this script, and that delay was visible in her reaction.
config_port() {
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/strawberry/config.toml"
  # No file yet (a fresh machine) is not an error: the default port stands. Returning non-zero
  # here would end the script, because `set -e` sees the assignment that calls this.
  [ -f "$cfg" ] || return 0
  awk -F'=' '/^\[/{s=$0} s=="[daemon]" && $1 ~ /^port[ \t]*$/ {gsub(/[^0-9]/,"",$2); print $2; exit}' "$cfg"
}
PORT="${STRAWBERRYD_PORT:-$(config_port)}"; PORT="${PORT:-8770}"
HEALTH="http://127.0.0.1:$PORT/health"
PIDFILE="$STATE_DIR/strawberryd.pid"
LOG="$STATE_DIR/strawberryd.log"
VOICES_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/strawberry/voices"
mkdir -p "$STATE_DIR"

daemon_up() { curl -fsS "$HEALTH" >/dev/null 2>&1; }
pid_alive() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }
wait_daemon() {
  for _ in $(seq 1 80); do daemon_up && return 0; sleep 0.1; done
  echo "strawberryd did not come up; see $LOG (or: journalctl --user -u strawberryd)" >&2
  return 1
}

# Doorways run on the daemon's venv now: the two D-Bus watchers are package modules (jeepney,
# no PyGObject), the beat watcher is still a script and needs only numpy, which the venv has.
DOORWAYS=(mpris_watch notify_watch beat_watch)
doorway_cmd() {  # $1 = doorway name -> the command that runs it
  case "$1" in
    beat_watch) echo "$PY -m strawberry.doorways.beat_watch" ;;
    *) echo "$PY -m strawberry.doorways.$1" ;;
  esac
}

# --- start on login (one systemd --user unit + an XDG autostart fallback) ------------
# The tray is the login process: it starts the daemon, the doorways and the widget itself
# and restarts what dies, so there is one unit instead of five (WIRING.md §14).
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/strawberry.desktop"
TRAY_UNIT=strawberry-tray.service
TRAY_STATE="$STATE_DIR/tray.json"
OLD_UNITS=(strawberryd.service); for w in "${DOORWAYS[@]}"; do OLD_UNITS+=("strawberry-$w.service"); done
tray_managed() { systemctl --user is-enabled "$TRAY_UNIT" >/dev/null 2>&1; }
legacy_managed() { systemctl --user is-enabled strawberryd.service >/dev/null 2>&1; }
managed() { tray_managed || legacy_managed; }
tray_pid() {  # the pid of a tray that is actually running, or nothing (the file outlives a crash)
  [ -f "$TRAY_STATE" ] || return 1
  local pid; pid="$("$PY" -c 'import json,sys;print(json.load(open(sys.argv[1]))["pid"])' "$TRAY_STATE" 2>/dev/null)" || return 1
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && echo "$pid"
}

write_units() {
  mkdir -p "$UNIT_DIR" "$(dirname "$AUTOSTART")"
  cat >"$UNIT_DIR/$TRAY_UNIT" <<EOF
[Unit]
Description=Strawberry: the tray icon, and under it the daemon, the doorways and the widget
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=$D --tray --port $PORT
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
EOF
  # The fallback for a session that never reaches graphical-session.target. It defers to the
  # unit when that is enabled, so the two can never start two trays.
  cat >"$AUTOSTART" <<EOF
[Desktop Entry]
Type=Application
Name=Strawberry
Comment=Desktop crab
Exec=$ROOT/bin/strawberry tray-autostart
X-GNOME-Autostart-Delay=3
StartupNotify=false
EOF
}

remove_old_units() {
  local found=0
  for u in "${OLD_UNITS[@]}"; do
    if [ -f "$UNIT_DIR/$u" ]; then found=1; fi
  done
  [ "$found" = 1 ] || return 0
  echo "removing the old per-doorway units (the tray starts them now)"
  systemctl --user disable --now "${OLD_UNITS[@]}" 2>/dev/null || true
  for u in "${OLD_UNITS[@]}"; do rm -f "$UNIT_DIR/$u"; done
}

install_login() {
  # Hand over from pidfile-managed processes, if any, so the port is free for the unit.
  stop_watchers_pidfile >/dev/null; stop_pidfile "$PIDFILE" "strawberryd" >/dev/null
  (cd "$ROOT" && uv sync --quiet --inexact --group gpu)
  remove_old_units
  write_units
  systemctl --user daemon-reload
  # The user manager needs the session's DISPLAY and bus address to run the widget and to
  # reach the notification bus; on GNOME they are usually there already, but not always.
  systemctl --user import-environment DISPLAY XAUTHORITY WAYLAND_DISPLAY XDG_SESSION_TYPE DBUS_SESSION_BUS_ADDRESS 2>/dev/null || true
  systemctl --user enable --now "$TRAY_UNIT"
  wait_daemon && echo "installed: $TRAY_UNIT runs the tray, the daemon, the doorways and the widget (autostart fallback: $AUTOSTART)"
  echo "logs: journalctl --user -u ${TRAY_UNIT%.service} -f"
}

uninstall_login() {
  systemctl --user disable --now "$TRAY_UNIT" 2>/dev/null || true
  rm -f "$UNIT_DIR/$TRAY_UNIT"
  remove_old_units
  systemctl --user daemon-reload
  rm -f "$AUTOSTART"
  echo "uninstalled: she now runs only when you start her with bin/strawberry"
}

# --- pidfile-managed processes (when not installed) ---------------------------------
start_watcher() {  # $1 = doorway name
  local pidfile="$STATE_DIR/$1.pid" logfile="$STATE_DIR/$1.log"
  if pid_alive "$pidfile"; then return; fi
  echo "starting $1 (log: $logfile)"
  # shellcheck disable=SC2046  # the command is ours, not user input
  nohup $(doorway_cmd "$1") --daemon "http://127.0.0.1:$PORT" >>"$logfile" 2>&1 &
  echo $! >"$pidfile"
}
stop_watchers_pidfile() { for w in "${DOORWAYS[@]}"; do stop_pidfile "$STATE_DIR/$w.pid" "$w"; done; }

stop_pidfile() {
  if [ -f "$1" ] && kill "$(cat "$1")" 2>/dev/null; then echo "$2 stopped"; else echo "$2: not running"; fi
  rm -f "$1"
}

tray_owns_children() { tray_managed || tray_pid >/dev/null || [ "${STRAWBERRY_TRAY:-}" = "1" ]; }

start_watchers() {
  if managed || tray_owns_children; then return; fi   # the tray (or the old units) start them
  for w in "${DOORWAYS[@]}"; do start_watcher "$w"; done
}
stop_watchers() {
  if managed || tray_owns_children; then return; fi   # they go with the tray, or with the old daemon unit
  stop_watchers_pidfile
}
status_watchers() {
  # Under the tray the doorways are its children; it writes what it has to tray.json.
  if tray_pid >/dev/null; then
    "$PY" - "$TRAY_STATE" <<'PY'
import json, sys
state = json.load(open(sys.argv[1]))
for child in state["children"]:
    print(f"{child['name']}: {'up' if child['running'] else 'down'}"
          f"{' pid ' + str(child['pid']) if child['pid'] else ''}"
          f"{' (' + str(child['restarts']) + ' restarts)' if child['restarts'] else ''}")
PY
    return
  fi
  for w in "${DOORWAYS[@]}"; do
    if legacy_managed; then echo "$w: $(systemctl --user is-active "strawberry-$w.service")"
    elif pid_alive "$STATE_DIR/$w.pid"; then echo "$w: up"; else echo "$w: down"; fi
  done
}

status_tray() {
  local pid; pid="$(tray_pid || true)"
  if tray_managed; then echo "tray: $(systemctl --user is-active "$TRAY_UNIT") ($TRAY_UNIT${pid:+, pid $pid})"
  elif [ -n "$pid" ]; then echo "tray: up (pid $pid, started by hand)"
  else echo "tray: down"; fi
}

start_daemon() {
  if daemon_up; then return; fi
  if [ "${STRAWBERRY_TRAY:-}" = "1" ]; then return; fi   # the tray starts the daemon itself
  if tray_managed; then
    systemctl --user start "$TRAY_UNIT"
    wait_daemon || exit 1
    return
  fi
  if legacy_managed; then
    systemctl --user start strawberryd.service
    wait_daemon || exit 1
    return
  fi
  (cd "$ROOT" && uv sync --quiet --inexact --group gpu)
  echo "starting strawberryd on :$PORT (log: $LOG)"
  nohup "$D" --port "$PORT" >>"$LOG" 2>&1 &
  echo $! >"$PIDFILE"
  wait_daemon || exit 1
}

stop_daemon() {
  if tray_managed; then systemctl --user stop "$TRAY_UNIT" && echo "tray stopped (with the daemon, the doorways and the widget)"; return; fi
  if legacy_managed; then systemctl --user stop strawberryd.service && echo "strawberryd stopped (systemd)"; return; fi
  local pid; pid="$(tray_pid || true)"
  if [ -n "$pid" ] && kill "$pid" 2>/dev/null; then echo "tray stopped (pid $pid, with its children)"; return; fi
  stop_pidfile "$PIDFILE" "strawberryd"
}

start_widget() {
  if [ ! -d "$ROOT/widget/.godot" ]; then
    echo "importing widget project (first run)"
    godot --headless --path "$ROOT/widget" --editor --import >/dev/null 2>&1 || true
  fi
  # Pinned to the X11 backend on purpose: native on an X11 session, XWayland on a
  # Wayland one. Native Wayland clients on GNOME get neither always-on-top nor
  # self-positioning, which is what makes a desktop pet a pet (WIRING.md §13).
  exec godot --display-driver x11 --path "$ROOT/widget" -- --ws="ws://127.0.0.1:$PORT/ws" "$@"
}

case "${1:-widget}" in
  widget) shift || true; start_daemon; start_watchers; start_widget "$@" ;;
  daemon) start_daemon; start_watchers; echo "strawberryd up on :$PORT" ;;
  tray) shift || true; exec "$D" --tray --port "$PORT" "$@" ;;
  tray-autostart)
    # The XDG autostart entry: the unit wins when it is enabled, so only one tray ever runs.
    if tray_managed; then echo "$TRAY_UNIT is enabled; leaving the tray to systemd"; exit 0; fi
    exec "$D" --tray --port "$PORT" ;;
  status)
    if tray_managed; then echo "managed by systemd --user ($TRAY_UNIT; strawberry uninstall to stop that)"
    elif legacy_managed; then echo "managed by the old systemd units (strawberry install moves her to the tray)"; fi
    status_tray
    if daemon_up; then curl -fsS "$HEALTH"; echo; else echo "strawberryd: down"; fi
    status_watchers
    daemon_up ;;
  stop)
    stop_watchers
    stop_daemon ;;
  restart)
    if tray_managed; then systemctl --user restart "$TRAY_UNIT"; wait_daemon && echo "restarted (systemd)"
    elif legacy_managed; then systemctl --user restart strawberryd.service; wait_daemon && echo "strawberryd restarted (systemd)"
    else "$0" stop; sleep 0.5; "$0" daemon; fi ;;
  install) install_login ;;
  uninstall) uninstall_login ;;
  config)
    CFG="${XDG_CONFIG_HOME:-$HOME/.config}/strawberry/config.toml"
    [ -f "$CFG" ] || "$D" --init-config
    if [ -n "${EDITOR:-}" ]; then "$EDITOR" "$CFG"; else echo "$CFG"; echo "(set \$EDITOR to open it automatically; restart with: strawberry restart)"; fi ;;
  listen)
    # The hotkey target: start listening, or end the recording early if she already is.
    curl -fsS -X POST "http://127.0.0.1:$PORT/listen" >/dev/null 2>&1 || exit 1 ;;
  hotkey)
    shift
    KEYPATH="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/strawberry/"
    SCHEMA="org.gnome.settings-daemon.plugins.media-keys"
    if [ "${1:-}" = "--remove" ]; then
      python3 - "$SCHEMA" "$KEYPATH" <<'PY'
import ast, subprocess, sys
schema, path = sys.argv[1:]
raw = subprocess.run(["gsettings", "get", schema, "custom-keybindings"], capture_output=True, text=True).stdout.strip()
paths = [] if raw.startswith("@as") else ast.literal_eval(raw)
paths = [p for p in paths if p != path]
subprocess.run(["gsettings", "set", schema, "custom-keybindings", str(paths)], check=True)
subprocess.run(["gsettings", "reset-recursively", f"{schema}.custom-keybinding:{path}"], check=False)
print("hotkey removed")
PY
      exit 0
    fi
    COMBO="${1:-<Super><Shift>space}"
    python3 - "$SCHEMA" "$KEYPATH" "$COMBO" "$ROOT/bin/strawberry listen" <<'PY'
import ast, subprocess, sys
schema, path, combo, command = sys.argv[1:]
raw = subprocess.run(["gsettings", "get", schema, "custom-keybindings"], capture_output=True, text=True).stdout.strip()
paths = [] if raw.startswith("@as") else ast.literal_eval(raw)
if path not in paths:
    paths.append(path)
    subprocess.run(["gsettings", "set", schema, "custom-keybindings", str(paths)], check=True)
key = f"{schema}.custom-keybinding:{path}"
subprocess.run(["gsettings", "set", key, "name", "Strawberry: listen"], check=True)
subprocess.run(["gsettings", "set", key, "command", command], check=True)
subprocess.run(["gsettings", "set", key, "binding", combo], check=True)
print(f"hotkey {combo} -> {command}")
PY
    ;;
  route)
    shift; [ $# -gt 0 ] || { echo "usage: strawberry route TEXT" >&2; exit 2; }
    exec "$D" --route "$*" ;;
  tools)
    shift; exec "$D" --tools ${1:+"$1"} ;;
  talk)
    exec "$D" --talk ;;
  think)
    shift; [ $# -ge 1 ] || { echo "usage: strawberry think TEXT" >&2; exit 2; }
    exec "$D" --think "$1" ;;
  tool)
    shift; [ $# -ge 2 ] || { echo "usage: strawberry tool SERVER NAME [JSON]" >&2; exit 2; }
    exec "$D" --tool "$1" "$2" --args "${3:-{\}}" ;;
  say)
    shift; [ $# -gt 0 ] || { echo "usage: strawberry say TEXT" >&2; exit 2; }
    daemon_up || { echo "strawberryd is down; start it with: strawberry daemon" >&2; exit 1; }
    jq -cn --arg t "$*" '{state:"talking", text:$t, emotion:"happy"}' \
      | curl -fsS -H 'Content-Type: application/json' -d @- "http://127.0.0.1:$PORT/perform" >/dev/null && echo "said: $*" ;;
  voices)
    shift
    if [ $# -eq 0 ]; then
      ls "$VOICES_DIR"/*.onnx 2>/dev/null | xargs -rn1 basename | sed 's/\.onnx$//' || true
      echo "(download more with: strawberry voices en_US-amy-medium; catalogue: https://rhasspy.github.io/piper-samples/)"
    else
      mkdir -p "$VOICES_DIR"
      ("$PY" -m piper.download_voices --download-dir "$VOICES_DIR" "$@")
    fi ;;
  audition)
    shift; LINE="${*:-James, hold the phone, the time is up! Your commit landed, nice work.}"
    for v in $("$0" voices | grep -v '^('); do
      WAV="$("$D" --say "$LINE" --voice "$v" 2>/dev/null)" || { echo "$v: failed" >&2; continue; }
      echo "$v"; paplay "$WAV" 2>/dev/null || aplay -q "$WAV"
    done ;;
  *) sed -n '2,22p' "$0"; exit 2 ;;
esac
